[Unit]
Description=Ji An scientific Discord teammate
After=network-online.target personal-agent-data.service personal-agent-research.service
Wants=network-online.target
Requires=personal-agent-data.service

[Service]
Type=simple
User=personal-agent
Group=personal-agent
WorkingDirectory=/var/lib/personal-agent/workspaces
Environment=HOME=/var/lib/personal-agent
Environment=CODEX_HOME=/var/lib/personal-agent/codex
Environment=HERMES_HOME=/var/lib/personal-agent/.hermes/profiles/ji-an
Environment=HERMES_KANBAN_HOME=/var/lib/personal-agent/.hermes
Environment=HERMES_KANBAN_DB=/var/lib/personal-agent/.hermes/kanban.db
Environment=PATH=/var/lib/personal-agent/.local/bin:/opt/personal-agents/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/999
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/999/bus
Environment=TZ=Asia/Kolkata
Environment=LANG=C.UTF-8
LoadCredential=discord_token:/etc/personal-agents/ji-an-discord.token
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
InaccessiblePaths=/root /home
BindReadOnlyPaths=/run/user/999/bus /run/user/999/systemd/private
PrivateTmp=yes
ReadWritePaths=/var/lib/personal-agent
MemoryMax=5G
TasksMax=256
LimitNOFILE=4096

ExecStart=/usr/bin/python3 /opt/personal-agents/launch.py --profile ji-an gateway run

[Install]
WantedBy=multi-user.target
